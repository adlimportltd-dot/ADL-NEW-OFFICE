full_schema
"-- ============================================================
create type client_type as enum ('private', 'business');

-- ============================================================
create type expense_category as enum ('goods', 'payroll', 'rent', 'utilities', 'fixed', 'variable', 'other');

-- ============================================================
create type expense_payment_status as enum ('paid', 'pending');

-- ============================================================
create type item_category as enum ('device', 'consumable');

-- ============================================================
create type item_condition as enum ('ok', 'faulty');

-- ============================================================
create type lead_status as enum ('new', 'contacted', 'quote_sent', 'awaiting_approval', 'closed_won', 'closed_lost');

-- ============================================================
create type location_type as enum ('warehouse', 'vehicle');

-- ============================================================
create type payment_method as enum ('bank_transfer', 'check', 'credit_card', 'cash');

-- ============================================================
create type payment_terms_type as enum ('prepaid_100', 'deposit_balance', 'net_x');

-- ============================================================
create type po_status as enum ('draft', 'sent', 'confirmed', 'received', 'cancelled', 'in_production', 'in_transit');

-- ============================================================
create type quote_status as enum ('draft', 'sent', 'accepted', 'rejected');

-- ============================================================
create type shipment_status as enum ('preparing', 'in_transit', 'planned');

-- ============================================================
create type shipping_rate_type as enum ('container_20ft', 'container_40ft', 'air_per_kg', 'other');

-- ============================================================
create type transaction_type as enum ('receive', 'transfer', 'install', 'return', 'writeoff', 'repack');

-- ============================================================
create type user_role as enum ('admin', 'technician', 'viewer');

-- ============================================================
create type vat_mode as enum ('incl', 'excl', 'zero');

-- ============================================================
create table app_settings (
  key text not null,
  value text
);

-- ============================================================
create table customers (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  address text,
  contact text,
  created_at timestamp with time zone not null default now(),
  phone text,
  email text,
  client_type client_type not null default 'private'::client_type
);

-- ============================================================
create table expense_payments (
  id uuid not null default uuid_generate_v4(),
  expense_id uuid not null,
  amount numeric not null,
  paid_date date not null default CURRENT_DATE,
  method payment_method,
  note text,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table expenses (
  id uuid not null default uuid_generate_v4(),
  category expense_category not null default 'other'::expense_category,
  supplier_id uuid,
  description text,
  invoice_number text,
  expense_date date not null default CURRENT_DATE,
  vat_mode vat_mode not null default 'incl'::vat_mode,
  amount_excl_vat numeric not null,
  vat_amount numeric not null,
  amount_incl_vat numeric not null,
  payment_status expense_payment_status not null default 'pending'::expense_payment_status,
  payment_method payment_method,
  notes text,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table items (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  category item_category not null,
  model text,
  color text,
  unit text not null,
  min_threshold numeric not null default 0,
  created_at timestamp with time zone not null default now(),
  unit_cost numeric,
  supplier_sku text,
  fragrance_group text
);

-- ============================================================
create table leads (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  phone text,
  email text,
  customer_id uuid,
  status lead_status not null default 'new'::lead_status,
  source text,
  estimated_value numeric,
  notes text,
  follow_up_date date,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table locations (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  type location_type not null,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table po_lines (
  id uuid not null default uuid_generate_v4(),
  po_id uuid not null,
  item_id uuid not null,
  qty numeric not null,
  unit_price numeric not null
);

-- ============================================================
create table po_payments (
  id uuid not null default uuid_generate_v4(),
  po_id uuid not null,
  amount numeric not null,
  paid_date date not null default CURRENT_DATE,
  note text,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table profiles (
  id uuid not null,
  full_name text,
  role user_role not null default 'technician'::user_role,
  location_id uuid,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table purchase_orders (
  id uuid not null default uuid_generate_v4(),
  po_number text not null,
  supplier_id uuid not null,
  status po_status not null default 'draft'::po_status,
  created_by uuid default auth.uid(),
  created_at timestamp with time zone not null default now(),
  currency text not null default 'USD'::text,
  shipping_terms text,
  notes text,
  shipment_id uuid,
  payment_terms payment_terms_type not null default 'prepaid_100'::payment_terms_type,
  deposit_percent numeric,
  net_days integer,
  due_date date
);

-- ============================================================
create table quote_lines (
  id uuid not null default uuid_generate_v4(),
  quote_id uuid not null,
  item_id uuid not null,
  qty numeric not null,
  unit_price numeric not null
);

-- ============================================================
create table quotes (
  id uuid not null default uuid_generate_v4(),
  quote_number text not null,
  customer_id uuid,
  lead_id uuid,
  status quote_status not null default 'draft'::quote_status,
  notes text,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table shipments (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  status shipment_status not null default 'preparing'::shipment_status,
  notes text,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table shipping_rate_cards (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  carrier text,
  notes text,
  created_at timestamp with time zone not null default now()
);

-- ============================================================
create table shipping_rates (
  id uuid not null default uuid_generate_v4(),
  rate_card_id uuid not null,
  rate_type shipping_rate_type not null default 'other'::shipping_rate_type,
  label text,
  price numeric not null,
  currency text not null default 'USD'::text
);

-- ============================================================
create table stock_levels (
  item_id uuid not null,
  location_id uuid not null,
  quantity numeric not null default 0,
  updated_at timestamp with time zone not null default now()
);

-- ============================================================
create table suppliers (
  id uuid not null default uuid_generate_v4(),
  name text not null,
  country text not null,
  contact text,
  phone text,
  email text,
  created_at timestamp with time zone not null default now(),
  currency text not null default 'USD'::text,
  notes text
);

-- ============================================================
create table transactions (
  id uuid not null default uuid_generate_v4(),
  type transaction_type not null,
  item_id uuid not null,
  qty numeric not null,
  from_location_id uuid,
  to_location_id uuid,
  customer_id uuid,
  condition item_condition,
  note text,
  performed_by uuid default auth.uid(),
  created_at timestamp with time zone not null default now(),
  unit_price numeric,
  supplier_id uuid
);

